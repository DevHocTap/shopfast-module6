# Local development only. Copy to apps/api/.env — values match infra/compose/docker-compose.yml.
# Production values come from SSM Parameter Store (see infra/aws/README.md). Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=shopfast
DB_PASSWORD=shopfast
DB_NAME=shopfast

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

WORKER_HEARTBEAT_FILE=./.worker-heartbeat

# Any random string of 32+ characters (production: SSM /shopfast/prod/JWT_ACCESS_SECRET)
JWT_ACCESS_SECRET=local-dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Password for the seeded demo accounts (admin/support/warehouse/customer @shopfast.local)
SEED_DEMO_PASSWORD=ShopFast@Local1

# Background jobs (worker). Locally emails go to Mailpit: http://localhost:8025
APP_PUBLIC_URL=http://localhost:5173
MAIL_TRANSPORT=smtp
MAIL_FROM=ShopFast <no-reply@shopfast.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Share of simulated partner calls that fail (0..1), to exercise retry and the dead letter
PARTNER_FAILURE_RATE=0.2
PAYMENT_REMINDER_DELAY_MINUTES=30
